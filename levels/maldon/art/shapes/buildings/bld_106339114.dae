<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_Spital Farm" name="Spital Farm">
      <mesh>
        <source id="geo_Spital Farm_pos">
          <float_array id="geo_Spital Farm_pos_arr" count="48">265.141 -519.942 36.649 270.868 -516.007 36.649 266.600 -509.795 36.649 269.016 -508.139 36.649 279.094 -522.820 36.649 275.824 -525.065 36.649 277.572 -527.610 36.649 272.706 -530.955 36.649 265.141 -519.942 44.649 270.868 -516.007 44.649 266.600 -509.795 44.649 269.016 -508.139 44.649 279.094 -522.820 44.649 275.824 -525.065 44.649 277.572 -527.610 44.649 272.706 -530.955 44.649</float_array>
          <technique_common>
            <accessor source="#geo_Spital Farm_pos_arr" count="16" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_Spital Farm_verts">
          <input semantic="POSITION" source="#geo_Spital Farm_pos"/>
        </vertices>
        <triangles count="22" material="Mat_building">
          <input semantic="VERTEX" source="#geo_Spital Farm_verts" offset="0"/>
          <p>0 1 9 0 9 8 1 2 10 1 10 9 2 3 11 2 11 10 3 4 12 3 12 11 4 5 13 4 13 12 5 6 14 5 14 13 6 7 15 6 15 14 7 0 8 7 8 15 15 9 8 9 11 10 9 12 11 9 13 12 15 13 9 13 15 14</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Building" name="Spital Farm" type="NODE">
        <instance_geometry url="#geo_Spital Farm">
          <bind_material>
            <technique_common>
              <instance_material symbol="Mat_building" target="#Mat_building"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
