        <source id="geo_Maldon Lodge Care Home_pos">
          <float_array id="geo_Maldon Lodge Care Home_pos_arr" count="48">543.615 290.906 34.321 567.955 282.415 34.321 559.819 259.076 34.321 545.653 264.022 34.321 550.278 277.292 34.321 546.664 278.548 34.321 547.284 280.315 34.321 540.724 282.604 34.321 543.615 290.906 42.321 567.955 282.415 42.321 559.819 259.076 42.321 545.653 264.022 42.321 550.278 277.292 42.321 546.664 278.548 42.321 547.284 280.315 42.321 540.724 282.604 42.321</float_array>
