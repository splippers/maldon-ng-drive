          <float_array id="geo_Maldon Marine_pos_arr" count="48">106.658 -847.024 28.270 104.834 -835.076 28.270 119.516 -832.842 28.270 121.333 -844.790 28.270 122.387 -851.669 28.270 118.539 -852.258 28.270 119.317 -857.337 28.270 108.475 -858.982 28.270 106.658 -847.024 36.270 104.834 -835.076 36.270 119.516 -832.842 36.270 121.333 -844.790 36.270 122.387 -851.669 36.270 118.539 -852.258 36.270 119.317 -857.337 36.270 108.475 -858.982 36.270</float_array>
