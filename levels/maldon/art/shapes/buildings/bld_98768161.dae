<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_Boots" name="Boots">
      <mesh>
        <source id="geo_Boots_pos">
          <float_array id="geo_Boots_pos_arr" count="54">1006.743 4.334 29.965 1006.805 5.112 29.965 1015.092 4.579 29.965 1014.225 -8.991 29.965 1011.320 -25.206 29.965 1012.243 -25.440 29.965 1010.356 -35.220 29.965 1002.317 -34.064 29.965 1006.144 -7.191 29.965 1006.743 4.334 37.965 1006.805 5.112 37.965 1015.092 4.579 37.965 1014.225 -8.991 37.965 1011.320 -25.206 37.965 1012.243 -25.440 37.965 1010.356 -35.220 37.965 1002.317 -34.064 37.965 1006.144 -7.191 37.965</float_array>
          <technique_common>
            <accessor source="#geo_Boots_pos_arr" count="18" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_Boots_verts">
          <input semantic="POSITION" source="#geo_Boots_pos"/>
        </vertices>
        <triangles count="25" material="Mat_building">
          <input semantic="VERTEX" source="#geo_Boots_verts" offset="0"/>
          <p>0 1 10 0 10 9 1 2 11 1 11 10 2 3 12 2 12 11 3 4 13 3 13 12 4 5 14 4 14 13 5 6 15 5 15 14 6 7 16 6 16 15 7 8 17 7 17 16 8 0 9 8 9 17 17 10 9 17 11 10 17 12 11 17 13 12 13 15 14 17 15 13 15 17 16</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Building" name="Boots" type="NODE">
        <instance_geometry url="#geo_Boots">
          <bind_material>
            <technique_common>
              <instance_material symbol="Mat_building" target="#Mat_building"/>
            </technique_common>
