<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_Maldon Books" name="Maldon Books">
      <mesh>
        <source id="geo_Maldon Books_pos">
          <float_array id="geo_Maldon Books_pos_arr" count="48">892.066 29.652 32.307 891.432 21.661 32.307 886.738 22.128 32.307 882.133 22.595 32.307 883.358 31.363 32.307 885.946 31.275 32.307 885.877 30.008 32.307 887.640 29.919 32.307 892.066 29.652 40.307 891.432 21.661 40.307 886.738 22.128 40.307 882.133 22.595 40.307 883.358 31.363 40.307 885.946 31.275 40.307 885.877 30.008 40.307 887.640 29.919 40.307</float_array>
          <technique_common>
            <accessor source="#geo_Maldon Books_pos_arr" count="16" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_Maldon Books_verts">
          <input semantic="POSITION" source="#geo_Maldon Books_pos"/>
        </vertices>
        <triangles count="22" material="Mat_building">
          <input semantic="VERTEX" source="#geo_Maldon Books_verts" offset="0"/>
          <p>0 1 9 0 9 8 1 2 10 1 10 9 2 3 11 2 11 10 3 4 12 3 12 11 4 5 13 4 13 12 5 6 14 5 14 13 6 7 15 6 15 14 7 0 8 7 8 15 15 9 8 15 10 9 15 11 10 11 13 12 11 14 13 11 15 14</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Building" name="Maldon Books" type="NODE">
        <instance_geometry url="#geo_Maldon Books">
          <bind_material>
            <technique_common>
              <instance_material symbol="Mat_building" target="#Mat_building"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
