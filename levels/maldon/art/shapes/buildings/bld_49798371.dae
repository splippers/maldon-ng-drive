<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_C&M Precision Ltd" name="C&M Precision Ltd">
      <mesh>
        <source id="geo_C&M Precision Ltd_pos">
          <float_array id="geo_C&M Precision Ltd_pos_arr" count="48">1069.918 483.032 3.544 1080.794 474.741 3.544 1065.795 455.070 3.544 1062.202 450.357 3.544 1058.754 452.991 3.544 1051.326 458.648 3.544 1052.297 459.927 3.544 1057.783 467.117 3.544 1069.918 483.032 11.544 1080.794 474.741 11.544 1065.795 455.070 11.544 1062.202 450.357 11.544 1058.754 452.991 11.544 1051.326 458.648 11.544 1052.297 459.927 11.544 1057.783 467.117 11.544</float_array>
          <technique_common>
            <accessor source="#geo_C&M Precision Ltd_pos_arr" count="16" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_C&M Precision Ltd_verts">
          <input semantic="POSITION" source="#geo_C&M Precision Ltd_pos"/>
        </vertices>
        <triangles count="22" material="Mat_building">
          <input semantic="VERTEX" source="#geo_C&M Precision Ltd_verts" offset="0"/>
          <p>0 1 9 0 9 8 1 2 10 1 10 9 2 3 11 2 11 10 3 4 12 3 12 11 4 5 13 4 13 12 5 6 14 5 14 13 6 7 15 6 15 14 7 0 8 7 8 15 15 9 8 15 10 9 15 11 10 15 12 11 15 13 12 13 15 14</p>
        </triangles>
