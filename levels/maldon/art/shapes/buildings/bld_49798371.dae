    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Building" name="C&M Precision Ltd" type="NODE">
        <instance_geometry url="#geo_C&M Precision Ltd">
          <bind_material>
