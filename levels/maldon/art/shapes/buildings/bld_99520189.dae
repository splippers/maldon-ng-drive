      <mesh>
        <source id="geo_Carpenters Arms_pos">
          <float_array id="geo_Carpenters Arms_pos_arr" count="60">834.968 115.351 32.900 841.665 111.261 32.900 845.864 118.141 32.900 847.372 117.218 32.900 851.612 124.164 32.900 846.188 127.476 32.900 845.740 126.743 32.900 841.342 129.421 32.900 837.177 122.609 32.900 838.795 121.619 32.900 834.968 115.351 40.900 841.665 111.261 40.900 845.864 118.141 40.900 847.372 117.218 40.900 851.612 124.164 40.900 846.188 127.476 40.900 845.740 126.743 40.900 841.342 129.421 40.900 837.177 122.609 40.900 838.795 121.619 40.900</float_array>
          <technique_common>
            <accessor source="#geo_Carpenters Arms_pos_arr" count="20" stride="3">
              <param name="X" type="float"/>
