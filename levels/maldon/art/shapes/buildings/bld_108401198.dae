<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_Beeleigh Abbey" name="Beeleigh Abbey">
      <mesh>
        <source id="geo_Beeleigh Abbey_pos">
          <float_array id="geo_Beeleigh Abbey_pos_arr" count="48">23.101 736.074 8.670 15.522 714.879 8.670 2.850 719.414 8.670 11.426 743.387 8.670 16.610 741.542 8.670 18.303 746.287 8.670 32.001 741.386 8.670 29.303 733.851 8.670 23.101 736.074 16.670 15.522 714.879 16.670 2.850 719.414 16.670 11.426 743.387 16.670 16.610 741.542 16.670 18.303 746.287 16.670 32.001 741.386 16.670 29.303 733.851 16.670</float_array>
          <technique_common>
            <accessor source="#geo_Beeleigh Abbey_pos_arr" count="16" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_Beeleigh Abbey_verts">
          <input semantic="POSITION" source="#geo_Beeleigh Abbey_pos"/>
        </vertices>
        <triangles count="22" material="Mat_building">
          <input semantic="VERTEX" source="#geo_Beeleigh Abbey_verts" offset="0"/>
          <p>0 1 9 0 9 8 1 2 10 1 10 9 2 3 11 2 11 10 3 4 12 3 12 11 4 5 13 4 13 12 5 6 14 5 14 13 6 7 15 6 15 14 7 0 8 7 8 15 8 10 9 8 11 10 15 11 8 15 12 11 15 13 12 13 15 14</p>
        </triangles>
