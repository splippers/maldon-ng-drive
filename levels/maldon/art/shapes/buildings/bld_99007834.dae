<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_William H. Brown" name="William H. Brown">
      <mesh>
        <source id="geo_William H. Brown_pos">
          <float_array id="geo_William H. Brown_pos_arr" count="30">822.027 1.867 33.760 827.727 4.157 33.760 823.844 11.614 33.760 818.861 9.313 33.760 819.707 7.391 33.760 822.027 1.867 41.760 827.727 4.157 41.760 823.844 11.614 41.760 818.861 9.313 41.760 819.707 7.391 41.760</float_array>
          <technique_common>
            <accessor source="#geo_William H. Brown_pos_arr" count="10" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_William H. Brown_verts">
          <input semantic="POSITION" source="#geo_William H. Brown_pos"/>
        </vertices>
        <triangles count="13" material="Mat_building">
          <input semantic="VERTEX" source="#geo_William H. Brown_verts" offset="0"/>
          <p>0 1 6 0 6 5 1 2 7 1 7 6 2 3 8 2 8 7 3 4 9 3 9 8 4 0 5 4 5 9 9 5 6 9 6 7 7 8 9</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Building" name="William H. Brown" type="NODE">
        <instance_geometry url="#geo_William H. Brown">
          <bind_material>
            <technique_common>
              <instance_material symbol="Mat_building" target="#Mat_building"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
