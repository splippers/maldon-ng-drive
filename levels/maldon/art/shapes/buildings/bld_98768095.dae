<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_Card Company" name="Card Company">
      <mesh>
        <source id="geo_Card Company_pos">
          <float_array id="geo_Card Company_pos_arr" count="42">995.839 4.857 30.203 1000.761 4.557 30.203 1000.431 -7.102 30.203 999.612 -16.437 30.203 994.621 -16.104 30.203 994.862 -5.501 30.203 995.743 -5.546 30.203 995.839 4.857 38.203 1000.761 4.557 38.203 1000.431 -7.102 38.203 999.612 -16.437 38.203 994.621 -16.104 38.203 994.862 -5.501 38.203 995.743 -5.546 38.203</float_array>
          <technique_common>
            <accessor source="#geo_Card Company_pos_arr" count="14" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_Card Company_verts">
          <input semantic="POSITION" source="#geo_Card Company_pos"/>
        </vertices>
        <triangles count="19" material="Mat_building">
          <input semantic="VERTEX" source="#geo_Card Company_verts" offset="0"/>
          <p>0 1 8 0 8 7 1 2 9 1 9 8 2 3 10 2 10 9 3 4 11 3 11 10 4 5 12 4 12 11 5 6 13 5 13 12 6 0 7 6 7 13 13 8 7 13 9 8 13 10 9 13 11 10 11 13 12</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Building" name="Card Company" type="NODE">
        <instance_geometry url="#geo_Card Company">
          <bind_material>
            <technique_common>
              <instance_material symbol="Mat_building" target="#Mat_building"/>
            </technique_common>
          </bind_material>
