<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_Longfield Medical Centre" name="Longfield Medical Centre">
      <mesh>
        <source id="geo_Longfield Medical Centre_pos">
          <float_array id="geo_Longfield Medical Centre_pos_arr" count="48">1059.036 -208.864 23.165 1085.199 -216.521 23.165 1079.245 -236.882 23.165 1073.456 -235.181 23.165 1072.809 -237.404 23.165 1057.687 -232.970 23.165 1058.375 -230.625 23.165 1053.116 -229.091 23.165 1059.036 -208.864 31.165 1085.199 -216.521 31.165 1079.245 -236.882 31.165 1073.456 -235.181 31.165 1072.809 -237.404 31.165 1057.687 -232.970 31.165 1058.375 -230.625 31.165 1053.116 -229.091 31.165</float_array>
          <technique_common>
            <accessor source="#geo_Longfield Medical Centre_pos_arr" count="16" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_Longfield Medical Centre_verts">
          <input semantic="POSITION" source="#geo_Longfield Medical Centre_pos"/>
        </vertices>
        <triangles count="22" material="Mat_building">
          <input semantic="VERTEX" source="#geo_Longfield Medical Centre_verts" offset="0"/>
          <p>0 1 9 0 9 8 1 2 10 1 10 9 2 3 11 2 11 10 3 4 12 3 12 11 4 5 13 4 13 12 5 6 14 5 14 13 6 7 15 6 15 14 7 0 8 7 8 15 15 9 8 9 11 10 11 13 12 9 13 11 9 14 13 9 15 14</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Building" name="Longfield Medical Centre" type="NODE">
        <instance_geometry url="#geo_Longfield Medical Centre">
          <bind_material>
            <technique_common>
              <instance_material symbol="Mat_building" target="#Mat_building"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
