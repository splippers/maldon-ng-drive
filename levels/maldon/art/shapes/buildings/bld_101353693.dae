      <mesh>
        <source id="geo_Taoist Tai Chi Society_pos">
          <float_array id="geo_Taoist Tai Chi Society_pos_arr" count="42">677.098 0.800 37.025 685.736 21.872 37.025 686.968 21.494 37.025 689.536 26.996 37.025 699.785 23.206 37.025 694.568 1.945 37.025 691.050 -5.179 37.025 677.098 0.800 55.025 685.736 21.872 55.025 686.968 21.494 55.025 689.536 26.996 55.025 699.785 23.206 55.025 694.568 1.945 55.025 691.050 -5.179 55.025</float_array>
          <technique_common>
            <accessor source="#geo_Taoist Tai Chi Society_pos_arr" count="14" stride="3">
              <param name="X" type="float"/>
