<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_materials>
    <material id="Mat_building" name="building">
      <instance_effect url="#Mat_building_effect"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="Mat_building_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.72 0.65 0.55 1</color></diffuse>
            <specular><color>0.05 0.05 0.05 1</color></specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="geo_Our Plaice" name="Our Plaice">
      <mesh>
        <source id="geo_Our Plaice_pos">
          <float_array id="geo_Our Plaice_pos_arr" count="42">488.624 -845.390 18.552 491.301 -844.078 18.552 487.013 -835.465 18.552 481.073 -838.255 18.552 479.744 -841.945 18.552 481.665 -846.457 18.552 484.556 -847.279 18.552 488.624 -845.390 26.552 491.301 -844.078 26.552 487.013 -835.465 26.552 481.073 -838.255 26.552 479.744 -841.945 26.552 481.665 -846.457 26.552 484.556 -847.279 26.552</float_array>
          <technique_common>
            <accessor source="#geo_Our Plaice_pos_arr" count="14" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geo_Our Plaice_verts">
          <input semantic="POSITION" source="#geo_Our Plaice_pos"/>
        </vertices>
        <triangles count="19" material="Mat_building">
          <input semantic="VERTEX" source="#geo_Our Plaice_verts" offset="0"/>
          <p>0 1 8 0 8 7 1 2 9 1 9 8 2 3 10 2 10 9 3 4 11 3 11 10 4 5 12 4 12 11 5 6 13 5 13 12 6 0 7 6 7 13 13 7 8 13 8 9 13 9 10 13 10 11 11 12 13</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="Building" name="Our Plaice" type="NODE">
        <instance_geometry url="#geo_Our Plaice">
          <bind_material>
            <technique_common>
              <instance_material symbol="Mat_building" target="#Mat_building"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
