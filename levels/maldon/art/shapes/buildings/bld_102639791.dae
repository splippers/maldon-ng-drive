          <float_array id="geo_Crematorium_pos_arr" count="84">-10.745 59.304 33.821 -5.940 59.426 33.821 -5.823 54.880 33.821 -3.634 54.936 33.821 -3.483 48.868 33.821 -4.536 48.834 33.821 -4.419 44.367 33.821 -7.998 44.278 33.821 -8.109 48.546 33.821 -12.851 48.423 33.821 -12.920 51.180 33.821 -15.302 51.113 33.821 -15.371 53.902 33.821 -10.614 54.025 33.821 -10.745 59.304 41.821 -5.940 59.426 41.821 -5.823 54.880 41.821 -3.634 54.936 41.821 -3.483 48.868 41.821 -4.536 48.834 41.821 -4.419 44.367 41.821 -7.998 44.278 41.821 -8.109 48.546 41.821 -12.851 48.423 41.821 -12.920 51.180 41.821 -15.302 51.113 41.821 -15.371 53.902 41.821 -10.614 54.025 41.821</float_array>
