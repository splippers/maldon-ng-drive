      <mesh>
        <source id="geo_Mighty Oak Tap Room_pos">
          <float_array id="geo_Mighty Oak Tap Room_pos_arr" count="36">827.169 -24.317 33.898 830.728 -22.828 33.898 827.093 -15.004 33.898 828.649 -14.070 33.898 824.629 -7.569 33.898 820.575 -9.980 33.898 827.169 -24.317 41.898 830.728 -22.828 41.898 827.093 -15.004 41.898 828.649 -14.070 41.898 824.629 -7.569 41.898 820.575 -9.980 41.898</float_array>
          <technique_common>
            <accessor source="#geo_Mighty Oak Tap Room_pos_arr" count="12" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
