      <mesh>
        <source id="geo_Maldon Ambulance Station_pos">
          <float_array id="geo_Maldon Ambulance Station_pos_arr" count="48">384.740 -370.771 37.325 388.271 -375.194 37.325 375.695 -385.230 37.325 372.556 -381.307 37.325 371.310 -382.296 37.325 364.929 -374.316 37.325 371.565 -369.015 37.325 377.553 -376.506 37.325 384.740 -370.771 45.325 388.271 -375.194 45.325 375.695 -385.230 45.325 372.556 -381.307 45.325 371.310 -382.296 45.325 364.929 -374.316 45.325 371.565 -369.015 45.325 377.553 -376.506 45.325</float_array>
          <technique_common>
            <accessor source="#geo_Maldon Ambulance Station_pos_arr" count="16" stride="3">
