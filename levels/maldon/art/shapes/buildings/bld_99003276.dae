          <float_array id="geo_Nemoz Aquatics_pos_arr" count="42">842.209 -45.823 32.878 835.119 -47.968 32.878 835.119 -48.912 32.878 831.912 -49.057 32.878 831.767 -59.048 32.878 842.911 -59.015 32.878 842.801 -50.668 32.878 842.209 -45.823 40.878 835.119 -47.968 40.878 835.119 -48.912 40.878 831.912 -49.057 40.878 831.767 -59.048 40.878 842.911 -59.015 40.878 842.801 -50.668 40.878</float_array>
